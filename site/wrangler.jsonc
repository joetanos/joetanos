{
  "name": "joetanos",
  "compatibility_date": "2026-09-01",
  "main": "./worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The home page goes through worker.js, which puts the print list in it (homePage)
    "run_worker_first": ["/"]
  },
  // Resizes photos for /img in worker.js
  "images": {
    "binding": "IMAGES"
  },
  // Visit statistics for /t in worker.js (see analytics/)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "justframed-analytics",
      "database_id": "70e481fa-67b3-486b-9b4e-0301a5cda7d6"
    }
  ],
  // Every 10 minutes: the daily report email at 22:00 Beirut time (dailyReport) and the new
  // release announcements to subscribers (announcements), see scheduled() in worker.js
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "send_email": [
    {
      "name": "MAILER",
      "destination_address": "justframed-lb@outlook.com"
    },
    // Promo code emails to newsletter subscribers (see subscribe in worker.js). Reaches any address
    // only once Email Sending is turned on for justframed-lb.com in the Cloudflare dashboard.
    {
      "name": "EMAIL"
    }
  ]
}
